.DS_Store

# Terraform configs, secrets
*.tfvars

#Terraform runtime
.terraform/
.terraform.lock.hcl
*.tfstate*
# Saved plans (contain a plaintext snapshot of state values)
*.tfplan
# Backend config (bucket name contains the account ID)
backend.hcl

# Legacy OpenVPN client configs (private keys). Kept ignored so leftovers can
# never be committed.
clients/
# WireGuard client configs (contain private keys)
clients-wg/
